{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"suspicious": {
				"noArrayIndexKey": "off"
			},
			"a11y": {
				"preset": "none"
			},
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"useShorthandAssign": "off",
				"useNodejsImportProtocol": "error",
				"useTemplate": "error"
			}
		}
	},
	"files": {
		"includes": ["src/**/*", "*.{js,json,ts,tsx}", "!!node_modules"],
		"ignoreUnknown": true
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	}
}
